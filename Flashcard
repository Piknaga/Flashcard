    const INITIAL_ACHIEVEMENTS = [
      { id: 'first_game', title: 'First Steps 🏆', desc: 'เล่นเกมหรือฝึกทบทวนครั้งแรก', icon: '🏆', unlocked: false, progress: 0, target: 1 },
      { id: 'streak_5', title: 'On Fire! 🔥', desc: 'ทำ Streak ตอบถูกต่อเนื่องครบ 5 ข้อ', icon: '🔥', unlocked: false, progress: 0, target: 5 },
      { id: 'vocab_100', title: 'Vocabulary Collector 📚', desc: 'สะสมคำศัพท์ในระบบครบ 20 คำขึ้นไป', icon: '📚', unlocked: false, progress: 0, target: 20 },
      { id: 'accuracy_90', title: 'Sharpshooter 🎯', desc: 'ทำ Accuracy สูงสุดเกิน 90% ในเกม', icon: '🎯', unlocked: false, progress: 0, target: 90 },
      { id: 'scholar', title: 'Dedicated Scholar 🧠', desc: 'เล่นจบการเรียนรู้ครบ 5 เซสชัน', icon: '🧠', unlocked: false, progress: 0, target: 5 }
    ];

    function App() {
      const [currentView, setCurrentView] = useState('home');
      const [activeSetId, setActiveSetId] = useState(null);

      const [sets, setSets] = useState(() => {
        const saved = localStorage.getItem('pik_vocab_sets');
        return saved ? JSON.parse(saved) : DEFAULT_SETS;
      });

      const [settings, setSettings] = useState(() => {
        const saved = localStorage.getItem('pik_vocab_settings');
        return saved ? JSON.parse(saved) : {
          darkMode: false,
          soundEnabled: true,
          livesEnabled: true,
          timerDuration: 10,
          autoNext: true,
          shuffleWords: true,
          questionCount: 10
        };
      });

      const [userStats, setUserStats] = useState(() => {
        const saved = localStorage.getItem('pik_vocab_stats');
        return saved ? JSON.parse(saved) : {
          totalGames: 0,
          totalQuestions: 0,
          totalCorrect: 0,
          totalWrong: 0,
          totalStudyTimeSeconds: 0,
          currentStreak: 0,
          bestStreak: 0,
          history: [],
          wordMastery: {}
        };
      });

      const [achievements, setAchievements] = useState(() => {
        const saved = localStorage.getItem('pik_vocab_achievements');
        return saved ? JSON.parse(saved) : INITIAL_ACHIEVEMENTS;
      });

      // Modals State
      const [isCreateSetModalOpen, setIsCreateSetModalOpen] = useState(false);
      const [isEditWordModalOpen, setIsEditWordModalOpen] = useState(false);
      const [isSettingsModalOpen, setIsSettingsModalOpen] = useState(false);
      const [isResetConfirmModalOpen, setIsResetConfirmModalOpen] = useState(false);

      const [wordFormData, setWordFormData] = useState({ id: '', word: '', meaning: '', pronunciation: '', example: '', note: '' });
      const [setFormData, setSetFormData] = useState({ id: '', name: '', description: '', category: 'General' });

      const [sessionData, setSessionData] = useState({
        mode: 'quiz',
        setName: '',
        words: [],
        currentIndex: 0,
        score: 0,
        correctCount: 0,
        wrongCount: 0,
        currentStreak: 0,
        bestStreak: 0,
        lives: 3,
        startTime: null,
        missedWords: []
      });

      useEffect(() => {
        if (settings.darkMode) {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
      }, [settings.darkMode]);

      useEffect(() => { localStorage.setItem('pik_vocab_sets', JSON.stringify(sets)); }, [sets]);
      useEffect(() => { localStorage.setItem('pik_vocab_settings', JSON.stringify(settings)); }, [settings]);
      useEffect(() => { localStorage.setItem('pik_vocab_stats', JSON.stringify(userStats)); }, [userStats]);
      useEffect(() => { localStorage.setItem('pik_vocab_achievements', JSON.stringify(achievements)); }, [achievements]);

      const activeSet = useMemo(() => sets.find(s => s.id === activeSetId) || sets[0] || null, [sets, activeSetId]);
      const totalWordsInApp = useMemo(() => sets.reduce((acc, s) => acc + (s.words ? s.words.length : 0), 0), [sets]);

      const startLearningMode = (mode, customWordsList = null, setOverride = null) => {
        playAudioFX('click', settings.soundEnabled);
        const targetSet = setOverride || activeSet;
        let sourceWords = customWordsList || (targetSet ? [...targetSet.words] : []);

        if (sourceWords.length === 0) {
          alert("ชุดคำศัพท์นี้ยังไม่มีคำศัพท์ กรุณาเพิ่มคำศัพท์ก่อนเริ่มเล่นครับ");
          return;
        }

        if (settings.shuffleWords) {
          sourceWords = [...sourceWords].sort(() => Math.random() - 0.5);
        }

        if (mode === 'quiz' && sourceWords.length > settings.questionCount) {
          sourceWords = sourceWords.slice(0, settings.questionCount);
        }

        setSessionData({
          mode,
          setName: targetSet ? targetSet.name : 'Custom Practice',
          words: sourceWords,
          currentIndex: 0,
          score: 0,
          correctCount: 0,
          wrongCount: 0,
          currentStreak: 0,
          bestStreak: 0,
          lives: settings.livesEnabled ? 3 : 999,
          startTime: Date.now(),
          missedWords: []
        });

        if (targetSet) {
          setSets(prev => prev.map(s => s.id === targetSet.id ? { ...s, lastPracticed: new Date().toISOString() } : s));
        }

        setCurrentView(mode);
      };

      const finishSession = (finalSession) => {
        const elapsedSeconds = Math.max(1, Math.round((Date.now() - finalSession.startTime) / 1000));
        const totalQ = finalSession.correctCount + finalSession.wrongCount;
        const accuracyPct = totalQ > 0 ? Math.round((finalSession.correctCount / totalQ) * 100) : 0;

        const newStats = {
          ...userStats,
          totalGames: userStats.totalGames + 1,
          totalQuestions: userStats.totalQuestions + totalQ,
          totalCorrect: userStats.totalCorrect + finalSession.correctCount,
          totalWrong: userStats.totalWrong + finalSession.wrongCount,
          totalStudyTimeSeconds: userStats.totalStudyTimeSeconds + elapsedSeconds,
          currentStreak: finalSession.bestStreak > userStats.currentStreak ? finalSession.bestStreak : userStats.currentStreak,
          bestStreak: Math.max(userStats.bestStreak, finalSession.bestStreak),
          history: [
            {
              date: new Date().toISOString(),
              score: finalSession.score,
              accuracy: accuracyPct,
              mode: finalSession.mode,
              setName: finalSession.setName,
              correct: finalSession.correctCount,
              wrong: finalSession.wrongCount,
              timeSec: elapsedSeconds
            },
            ...userStats.history.slice(0, 19)
          ]
        };

        const updatedMastery = { ...userStats.wordMastery };
        finalSession.words.forEach(word => {
          const isMissed = finalSession.missedWords.some(m => m.id === word.id);
          const currentWordStat = updatedMastery[word.id] || { correctCount: 0, wrongCount: 0, lastTested: new Date().toISOString() };
          if (isMissed) currentWordStat.wrongCount += 1;
          else currentWordStat.correctCount += 1;
          currentWordStat.lastTested = new Date().toISOString();
          updatedMastery[word.id] = currentWordStat;
        });

        newStats.wordMastery = updatedMastery;
        setUserStats(newStats);

        setAchievements(prev => prev.map(ach => {
          let progress = ach.progress;
          let unlocked = ach.unlocked;
          if (ach.id === 'first_game') progress = newStats.totalGames;
          if (ach.id === 'streak_5') progress = newStats.bestStreak;
          if (ach.id === 'vocab_100') progress = totalWordsInApp;
          if (ach.id === 'scholar') progress = newStats.totalGames;
          if (ach.id === 'accuracy_90' && accuracyPct >= 90) unlocked = true;
          if (progress >= ach.target) unlocked = true;
          return { ...ach, progress, unlocked };
        }));

        playAudioFX('victory', settings.soundEnabled);
        setCurrentView('results');
      };

      const handleResetAllData = () => {
        localStorage.clear();
        setSets(DEFAULT_SETS);
        setSettings({ darkMode: false, soundEnabled: true, livesEnabled: true, timerDuration: 10, autoNext: true, shuffleWords: true, questionCount: 10 });
        setUserStats({ totalGames: 0, totalQuestions: 0, totalCorrect: 0, totalWrong: 0, totalStudyTimeSeconds: 0, currentStreak: 0, bestStreak: 0, history: [], wordMastery: {} });
        setAchievements(INITIAL_ACHIEVEMENTS);
        setIsResetConfirmModalOpen(false);
        setIsSettingsModalOpen(false);
        setCurrentView('home');
      };

      return (
        <div className="min-h-screen flex flex-col justify-between">
          <div>
            <!-- Main Navbar -->
            <header className="sticky top-0 z-30 backdrop-blur-md border-b bg-white/90 dark:bg-slate-900/90 border-slate-200 dark:border-slate-800 shadow-sm">
              <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
                
                <div 
                  className="flex items-center space-x-3 cursor-pointer group"
                  onClick={() => { playAudioFX('click', settings.soundEnabled); setCurrentView('home'); }}
                >
                  <div className="w-10 h-10 rounded-2xl bg-gradient-to-tr from-indigo-600 to-violet-500 flex items-center justify-center text-white shadow-lg shadow-indigo-500/30 group-hover:scale-105 transition-transform">
                    <IconSparkles />
                  </div>
                  <div>
                    <span className="font-bold text-lg sm:text-xl tracking-tight bg-gradient-to-r from-indigo-600 via-violet-600 to-purple-600 dark:from-indigo-400 dark:to-purple-400 bg-clip-text text-transparent">
                      Pik Vocabulary Flashcards
                    </span>
                  </div>
                </div>

                <div className="flex items-center space-x-1 sm:space-x-3">
                  <button
                    onClick={() => { playAudioFX('click', settings.soundEnabled); setCurrentView('home'); }}
                    className={`px-3 py-2 rounded-xl text-xs sm:text-sm font-semibold transition-all flex items-center space-x-1.5 ${currentView === 'home' ? 'bg-indigo-50 text-indigo-600 dark:bg-slate-800 dark:text-indigo-400' : 'hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-600 dark:text-slate-300'}`}
                  >
                    <IconBook /> <span className="hidden md:inline">Dashboard</span>
                  </button>

                  <button
                    onClick={() => { playAudioFX('click', settings.soundEnabled); setCurrentView('stats'); }}
                    className={`px-3 py-2 rounded-xl text-xs sm:text-sm font-semibold transition-all flex items-center space-x-1.5 ${currentView === 'stats' ? 'bg-indigo-50 text-indigo-600 dark:bg-slate-800 dark:text-indigo-400' : 'hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-600 dark:text-slate-300'}`}
                  >
                    <IconBarChart /> <span className="hidden md:inline">Statistics</span>
                  </button>

                  <button
                    onClick={() => { playAudioFX('click', settings.soundEnabled); setCurrentView('achievements'); }}
                    className={`px-3 py-2 rounded-xl text-xs sm:text-sm font-semibold transition-all flex items-center space-x-1.5 ${currentView === 'achievements' ? 'bg-indigo-50 text-indigo-600 dark:bg-slate-800 dark:text-indigo-400' : 'hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-600 dark:text-slate-300'}`}
                  >
                    <IconTrophy className="w-4 h-4 text-amber-500" /> <span className="hidden md:inline">Badges</span>
                  </button>

                  <div className="hidden sm:flex items-center space-x-1 px-3 py-1.5 rounded-full bg-amber-50 dark:bg-amber-950/50 border border-amber-200 dark:border-amber-800 text-amber-700 dark:text-amber-400 font-semibold text-xs">
                    <IconFlame className="w-4 h-4 text-amber-500" />
                    <span>🔥 {userStats.currentStreak}</span>
                  </div>

                  <button
                    onClick={() => setSettings(prev => ({ ...prev, darkMode: !prev.darkMode }))}
                    className="p-2 rounded-xl hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-600 dark:text-slate-300 transition-colors"
                  >
                    {settings.darkMode ? <IconSun className="text-amber-400" /> : <IconMoon />}
                  </button>

                  <button
                    onClick={() => setIsSettingsModalOpen(true)}
                    className="p-2 rounded-xl hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-600 dark:text-slate-300 transition-colors"
                  >
                    <IconSettings />
                  </button>
                </div>
              </div>
            </header>

            <!-- Main Content Router -->
            <main className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 w-full">
              {currentView === 'home' && (
                <HomeView 
                  sets={sets}
                  userStats={userStats}
                  totalWordsInApp={totalWordsInApp}
                  onSelectSet={(setId) => setActiveSetId(setId)}
                  onManageSet={(setId) => { setActiveSetId(setId); setCurrentView('manage_set'); }}
                  onStartMode={(mode, setId) => {
                    setActiveSetId(setId);
                    const target = sets.find(s => s.id === setId);
                    startLearningMode(mode, null, target);
                  }}
                  onCreateSet={() => setIsCreateSetModalOpen(true)}
                  onDeleteSet={(setId) => {
                    if (confirm("คุณต้องการลบชุดคำศัพท์นี้ใช่หรือไม่?")) {
                      setSets(prev => prev.filter(s => s.id !== setId));
                    }
                  }}
                  settings={settings}
                />
              )}

              {currentView === 'manage_set' && (
                <ManageSetView 
                  set={activeSet}
                  onBack={() => setCurrentView('home')}
                  onAddWord={() => { setWordFormData({ id: '', word: '', meaning: '', pronunciation: '', example: '', note: '' }); setIsEditWordModalOpen(true); }}
                  onEditWord={(word) => { setWordFormData(word); setIsEditWordModalOpen(true); }}
                  onDeleteWord={(wordId) => {
                    setSets(prev => prev.map(s => s.id === activeSet.id ? { ...s, words: s.words.filter(w => w.id !== wordId) } : s));
                  }}
                  onQuickStart={(mode) => startLearningMode(mode)}
                  settings={settings}
                />
              )}

              {currentView === 'flashcard' && (
                <FlashcardMode session={sessionData} onFinish={finishSession} onBack={() => setCurrentView('home')} settings={settings} />
              )}

              {currentView === 'matching' && (
                <MatchingMode session={sessionData} onFinish={finishSession} onBack={() => setCurrentView('home')} settings={settings} />
              )}

              {currentView === 'quiz' && (
                <QuizMode session={sessionData} onFinish={finishSession} onBack={() => setCurrentView('home')} settings={settings} />
              )}

              {currentView === 'results' && (
                <ResultsView 
                  session={sessionData}
                  onPlayAgain={() => startLearningMode(sessionData.mode, sessionData.words)}
                  onPracticeMistakes={() => {
                    if (sessionData.missedWords.length === 0) return;
                    startLearningMode('quiz', sessionData.missedWords);
                  }}
                  onHome={() => setCurrentView('home')}
                  onViewStats={() => setCurrentView('stats')}
                  settings={settings}
                />
              )}

              {currentView === 'stats' && <StatsDashboardView userStats={userStats} sets={sets} settings={settings} />}
              {currentView === 'achievements' && <AchievementsView achievements={achievements} settings={settings} />}
            </main>
          </div>

          <!-- Footer Credit -->
          <footer className="w-full py-5 border-t border-slate-200 dark:border-slate-800 text-center text-xs font-semibold text-slate-500 dark:text-slate-400 bg-white/50 dark:bg-slate-900/50 backdrop-blur-sm mt-8">
            <div className="flex items-center justify-center gap-1.5">
              <span>Pik Vocabulary Flashcards</span>
              <span>•</span>
              <span className="text-indigo-600 dark:text-indigo-400 font-bold">made by Nong Pik</span>
            </div>
          </footer>

          <!-- Modals -->
          {isCreateSetModalOpen && (
            <div className="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-sm animate-pop">
              <div className={`w-full max-w-md rounded-3xl p-6 shadow-2xl border ${settings.darkMode ? 'bg-slate-800 border-slate-700 text-white' : 'bg-white border-slate-200 text-slate-800'}`}>
                <div className="flex justify-between items-center mb-4">
                  <h3 className="text-xl font-bold flex items-center gap-2">สร้างชุดคำศัพท์ใหม่</h3>
                  <button onClick={() => setIsCreateSetModalOpen(false)} className="p-1 rounded-full hover:bg-slate-100 dark:hover:bg-slate-700"><IconX /></button>
                </div>
                <form onSubmit={(e) => {
                  e.preventDefault();
                  if (!setFormData.name.trim()) return;
                  const newSet = {
                    id: 'set-' + Date.now(),
                    name: setFormData.name,
                    description: setFormData.description || 'Custom vocabulary set',
                    category: setFormData.category || 'General',
                    createdAt: new Date().toISOString(),
                    lastPracticed: null,
                    words: []
                  };
                  setSets(prev => [newSet, ...prev]);
                  setActiveSetId(newSet.id);
                  setIsCreateSetModalOpen(false);
                  setSetFormData({ id: '', name: '', description: '', category: 'General' });
                  setCurrentView('manage_set');
                }} className="space-y-4">
                  <div>
                    <label className="block text-xs font-semibold uppercase text-slate-500 mb-1">ชื่อชุดคำศัพท์ *</label>
                    <input type="text" required placeholder="เช่น คำศัพท์การท่องเที่ยว, TOEIC" value={setFormData.name} onChange={e => setSetFormData({ ...setFormData, name: e.target.value })} className={`w-full px-4 py-2.5 rounded-xl border text-sm outline-none ${settings.darkMode ? 'bg-slate-900 border-slate-700' : 'bg-slate-50 border-slate-200'}`} />
                  </div>
                  <div>
                    <label className="block text-xs font-semibold uppercase text-slate-500 mb-1">หมวดหมู่</label>
                    <select value={setFormData.category} onChange={e => setSetFormData({ ...setFormData, category: e.target.value })} className={`w-full px-4 py-2.5 rounded-xl border text-sm outline-none ${settings.darkMode ? 'bg-slate-900 border-slate-700' : 'bg-slate-50 border-slate-200'}`}>
                      <option value="General">General</option>
                      <option value="Business">Business</option>
                      <option value="Exam Prep">Exam Prep</option>
                      <option value="Travel">Travel</option>
                    </select>
                  </div>
                  <div>
                    <label className="block text-xs font-semibold uppercase text-slate-500 mb-1">คำอธิบาย</label>
                    <textarea rows={3} placeholder="รายละเอียดสั้นๆ..." value={setFormData.description} onChange={e => setSetFormData({ ...setFormData, description: e.target.value })} className={`w-full px-4 py-2.5 rounded-xl border text-sm outline-none ${settings.darkMode ? 'bg-slate-900 border-slate-700' : 'bg-slate-50 border-slate-200'}`} />
                  </div>
                  <div className="flex justify-end gap-3 pt-2">
                    <button type="button" onClick={() => setIsCreateSetModalOpen(false)} className="px-4 py-2 rounded-xl text-sm font-semibold">ยกเลิก</button>
                    <button type="submit" className="px-5 py-2 rounded-xl text-sm font-semibold bg-indigo-600 text-white shadow-lg shadow-indigo-500/30">สร้างชุดคำศัพท์</button>
                  </div>
                </form>
              </div>
            </div>
          )}

          {isEditWordModalOpen && (
            <div className="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-sm animate-pop">
              <div className={`w-full max-w-lg rounded-3xl p-6 shadow-2xl border ${settings.darkMode ? 'bg-slate-800 border-slate-700 text-white' : 'bg-white border-slate-200 text-slate-800'}`}>
                <div className="flex justify-between items-center mb-4">
                  <h3 className="text-xl font-bold">{wordFormData.id ? 'แก้ไขคำศัพท์' : 'เพิ่มคำศัพท์ใหม่'}</h3>
                  <button onClick={() => setIsEditWordModalOpen(false)} className="p-1 rounded-full hover:bg-slate-100 dark:hover:bg-slate-700"><IconX /></button>
                </div>
                <form onSubmit={(e) => {
                  e.preventDefault();
                  if (!wordFormData.word.trim() || !wordFormData.meaning.trim()) return;
                  if (wordFormData.id) {
                    setSets(prev => prev.map(s => s.id === activeSet.id ? { ...s, words: s.words.map(w => w.id === wordFormData.id ? wordFormData : w) } : s));
                  } else {
                    const newWord = { ...wordFormData, id: 'word-' + Date.now() };
                    setSets(prev => prev.map(s => s.id === activeSet.id ? { ...s, words: [...s.words, newWord] } : s));
                  }
                  setIsEditWordModalOpen(false);
                }} className="space-y-3">
                  <div className="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <div>
                      <label className="block text-xs font-semibold uppercase text-slate-500 mb-1">English Word *</label>
                      <input type="text" required placeholder="เช่น Resilient" value={wordFormData.word} onChange={e => setWordFormData({ ...wordFormData, word: e.target.value })} className={`w-full px-3.5 py-2 rounded-xl border text-sm outline-none ${settings.darkMode ? 'bg-slate-900 border-slate-700' : 'bg-slate-50 border-slate-200'}`} />
                    </div>
                    <div>
                      <label className="block text-xs font-semibold uppercase text-slate-500 mb-1">Thai Meaning *</label>
                      <input type="text" required placeholder="เช่น ฟื้นตัวได้เร็ว" value={wordFormData.meaning} onChange={e => setWordFormData({ ...wordFormData, meaning: e.target.value })} className={`w-full px-3.5 py-2 rounded-xl border text-sm outline-none ${settings.darkMode ? 'bg-slate-900 border-slate-700' : 'bg-slate-50 border-slate-200'}`} />
                    </div>
                  </div>
                  <div className="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <div>
                      <label className="block text-xs font-semibold uppercase text-slate-500 mb-1">คำอ่าน (Pronunciation)</label>
                      <input type="text" placeholder="เช่น รี-ซิล-เลียนท์" value={wordFormData.pronunciation} onChange={e => setWordFormData({ ...wordFormData, pronunciation: e.target.value })} className={`w-full px-3.5 py-2 rounded-xl border text-sm outline-none ${settings.darkMode ? 'bg-slate-900 border-slate-700' : 'bg-slate-50 border-slate-200'}`} />
                    </div>
                    <div>
                      <label className="block text-xs font-semibold uppercase text-slate-500 mb-1">Note / POS</label>
                      <input type="text" placeholder="เช่น Adjective" value={wordFormData.note} onChange={e => setWordFormData({ ...wordFormData, note: e.target.value })} className={`w-full px-3.5 py-2 rounded-xl border text-sm outline-none ${settings.darkMode ? 'bg-slate-900 border-slate-700' : 'bg-slate-50 border-slate-200'}`} />
                    </div>
                  </div>
                  <div>
                    <label className="block text-xs font-semibold uppercase text-slate-500 mb-1">ประโยคตัวอย่าง (Example)</label>
                    <textarea rows={2} placeholder="เช่น Children are surprisingly resilient." value={wordFormData.example} onChange={e => setWordFormData({ ...wordFormData, example: e.target.value })} className={`w-full px-3.5 py-2 rounded-xl border text-sm outline-none ${settings.darkMode ? 'bg-slate-900 border-slate-700' : 'bg-slate-50 border-slate-200'}`} />
                  </div>
                  <div className="flex justify-end gap-3 pt-2">
                    <button type="button" onClick={() => setIsEditWordModalOpen(false)} className="px-4 py-2 rounded-xl text-sm font-semibold">ยกเลิก</button>
                    <button type="submit" className="px-5 py-2 rounded-xl text-sm font-semibold bg-indigo-600 text-white shadow-lg shadow-indigo-500/30">บันทึกคำศัพท์</button>
                  </div>
                </form>
              </div>
            </div>
          )}

          {isSettingsModalOpen && (
            <div className="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-sm animate-pop">
