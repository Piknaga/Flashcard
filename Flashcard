    function MatchingMode({ session, onFinish, onBack, settings }) {
      const [leftCards, setLeftCards] = useState([]);
      const [rightCards, setRightCards] = useState([]);
      const [selectedLeft, setSelectedLeft] = useState(null);
      const [selectedRight, setSelectedRight] = useState(null);
      const [matchedIds, setMatchedIds] = useState([]);
      const [shakingIds, setShakingIds] = useState([]);
      const [lives, setLives] = useState(session.lives);
      const [score, setScore] = useState(0);
      const [streak, setStreak] = useState(0);

      useEffect(() => {
        const sampleWords = session.words.slice(0, 8);
        setLeftCards(sampleWords.map(w => ({ id: w.id, text: w.word, original: w })).sort(() => Math.random() - 0.5));
        setRightCards(sampleWords.map(w => ({ id: w.id, text: w.meaning, original: w })).sort(() => Math.random() - 0.5));
      }, [session.words]);

      useEffect(() => {
        if (selectedLeft && selectedRight) {
          if (selectedLeft.id === selectedRight.id) {
            playAudioFX('correct', settings.soundEnabled);
            const newScore = score + 10 + (streak * 2);
            setScore(newScore);
            setStreak(s => s + 1);
            setMatchedIds(prev => [...prev, selectedLeft.id]);
            setSelectedLeft(null);
            setSelectedRight(null);

            if (matchedIds.length + 1 === leftCards.length) {
              setTimeout(() => onFinish({ ...session, score: newScore, correctCount: leftCards.length, wrongCount: 0, bestStreak: streak + 1, missedWords: [] }), 600);
            }
          } else {
            playAudioFX('wrong', settings.soundEnabled);
            setShakingIds([selectedLeft.id, selectedRight.id]);
            setStreak(0);
            if (settings.livesEnabled) {
              const newLives = lives - 1;
              setLives(newLives);
              if (newLives <= 0) setTimeout(() => onFinish({ ...session, score, correctCount: matchedIds.length, wrongCount: 1, bestStreak: streak, missedWords: [selectedLeft.original] }), 600);
            }
            setTimeout(() => { setSelectedLeft(null); setSelectedRight(null); setShakingIds([]); }, 500);
          }
        }
      }, [selectedLeft, selectedRight]);

      return (
        <div className="max-w-3xl mx-auto space-y-6 animate-pop">
          <div className="flex justify-between items-center bg-white dark:bg-slate-800 p-4 rounded-3xl border shadow-sm">
            <button onClick={onBack} className="flex items-center gap-1 text-xs font-semibold text-slate-500"><IconArrowLeft /> ออก</button>
            {settings.livesEnabled && (
              <div className="flex items-center gap-1">
                {[1, 2, 3].map(i => <IconHeart key={i} className={`w-5 h-5 ${i <= lives ? 'text-rose-500' : 'text-slate-300'}`} />)}
              </div>
            )}
            <div className="text-xs font-bold text-indigo-600 dark:text-indigo-400">คะแนน: {score}</div>
          </div>

          <div className="grid grid-cols-2 gap-4">
            <div className="space-y-3">
              <h4 className="text-xs font-bold uppercase text-slate-400 text-center">คำศัพท์ภาษาอังกฤษ</h4>
              {leftCards.map(card => {
                const isMatched = matchedIds.includes(card.id);
                const isSelected = selectedLeft && selectedLeft.id === card.id;
                const isShaking = shakingIds.includes(card.id);
                if (isMatched) return <div key={card.id} className="p-4 rounded-2xl bg-emerald-50 dark:bg-emerald-950/40 text-emerald-600 font-bold text-center opacity-60">✓ จับคู่แล้ว</div>;
                return (
                  <button key={card.id} onClick={() => { playAudioFX('click', settings.soundEnabled); setSelectedLeft(card); }} className={`w-full p-4 rounded-2xl border text-sm font-bold transition-all ${isShaking ? 'animate-shake bg-rose-100 text-rose-700' : isSelected ? 'bg-indigo-600 text-white' : settings.darkMode ? 'bg-slate-800 border-slate-700' : 'bg-white border-slate-200'}`}>
                    {card.text}
                  </button>
                );
              })}
            </div>

            <div className="space-y-3">
              <h4 className="text-xs font-bold uppercase text-slate-400 text-center">คำแปลภาษาไทย</h4>
              {rightCards.map(card => {
                const isMatched = matchedIds.includes(card.id);
                const isSelected = selectedRight && selectedRight.id === card.id;
                const isShaking = shakingIds.includes(card.id);
                if (isMatched) return <div key={card.id} className="p-4 rounded-2xl bg-emerald-50 dark:bg-emerald-950/40 text-emerald-600 font-bold text-center opacity-60">✓ จับคู่แล้ว</div>;
                return (
                  <button key={card.id} onClick={() => { playAudioFX('click', settings.soundEnabled); setSelectedRight(card); }} className={`w-full p-4 rounded-2xl border text-sm font-bold transition-all ${isShaking ? 'animate-shake bg-rose-100 text-rose-700' : isSelected ? 'bg-indigo-600 text-white' : settings.darkMode ? 'bg-slate-800 border-slate-700' : 'bg-white border-slate-200'}`}>
                    {card.text}
                  </button>
                );
              })}
            </div>
          </div>
        </div>
      );
    }

    function QuizMode({ session, onFinish, onBack, settings }) {
      const [currentIndex, setCurrentIndex] = useState(0);
      const [options, setOptions] = useState([]);
      const [selectedOption, setSelectedOption] = useState(null);
      const [isAnswered, setIsAnswered] = useState(false);
      const [timeLeft, setTimeLeft] = useState(settings.timerDuration);
      const [lives, setLives] = useState(session.lives);
      const [score, setScore] = useState(0);
      const [streak, setStreak] = useState(0);
      const [bestStreak, setBestStreak] = useState(0);
      const [missedWords, setMissedWords] = useState([]);
      const [correctCount, setCorrectCount] = useState(0);
      const [wrongCount, setWrongCount] = useState(0);

      const currentWord = session.words[currentIndex];

      useEffect(() => {
        if (!currentWord) return;
        const correctMeaning = currentWord.meaning;
        let allMeanings = session.words.map(w => w.meaning).filter(m => m !== correctMeaning);
        if (allMeanings.length < 3) allMeanings = [...allMeanings, 'ความสัมพันธ์', 'นวัตกรรมล้ำสมัย', 'การประเมินผล'];
        const shuffledDistractors = [...allMeanings].sort(() => Math.random() - 0.5).slice(0, 3);
        setOptions([correctMeaning, ...shuffledDistractors].sort(() => Math.random() - 0.5));
        setSelectedOption(null);
        setIsAnswered(false);
        setTimeLeft(settings.timerDuration);
      }, [currentIndex, currentWord]);

      useEffect(() => {
        if (isAnswered) return;
        if (timeLeft <= 0) { handleTimeout(); return; }
        const timer = setInterval(() => setTimeLeft(prev => prev - 0.1), 100);
        return () => clearInterval(timer);
      }, [timeLeft, isAnswered]);

      const handleTimeout = () => {
        playAudioFX('timeout', settings.soundEnabled);
        setIsAnswered(true);
        setWrongCount(p => p + 1);
        setStreak(0);
        setMissedWords(prev => [...prev, currentWord]);
        if (settings.livesEnabled) {
          const newLives = lives - 1;
          setLives(newLives);
          if (newLives <= 0) {
            setTimeout(() => finishGame(score, correctCount, wrongCount + 1, streak, bestStreak, [...missedWords, currentWord]), 1000);
            return;
          }
        }
        if (settings.autoNext) setTimeout(() => proceedNext(), 1200);
      };

      const handleSelectOption = (opt) => {
        if (isAnswered) return;
        setSelectedOption(opt);
        setIsAnswered(true);
        const isCorrect = opt === currentWord.meaning;

        if (isCorrect) {
          playAudioFX('correct', settings.soundEnabled);
          const roundScore = 10 + Math.round(timeLeft * 2) + (streak * 5);
          const newScore = score + roundScore;
          const newStreak = streak + 1;
          setScore(newScore);
          setCorrectCount(p => p + 1);
          setStreak(newStreak);
          setBestStreak(Math.max(bestStreak, newStreak));
        } else {
          playAudioFX('wrong', settings.soundEnabled);
          setWrongCount(p => p + 1);
          setStreak(0);
          setMissedWords(prev => [...prev, currentWord]);
          if (settings.livesEnabled) {
            const newLives = lives - 1;
            setLives(newLives);
            if (newLives <= 0) {
              setTimeout(() => finishGame(score, correctCount, wrongCount + 1, streak, bestStreak, [...missedWords, currentWord]), 1200);
              return;
            }
          }
        }
        if (settings.autoNext) setTimeout(() => proceedNext(), 1200);
      };

      const proceedNext = () => {
        if (currentIndex < session.words.length - 1) setCurrentIndex(p => p + 1);
        else finishGame(score, correctCount, wrongCount, streak, bestStreak, missedWords);
      };

      const finishGame = (fScore, fCorrect, fWrong, fStreak, fBestStreak, fMissed) => {
        onFinish({ ...session, score: fScore, correctCount: fCorrect, wrongCount: fWrong, bestStreak: fBestStreak, missedWords: fMissed });
      };

      if (!currentWord) return null;
      const timerPct = Math.max(0, (timeLeft / settings.timerDuration) * 100);

      return (
        <div className="max-w-2xl mx-auto space-y-6 animate-pop">
          <div className="flex justify-between items-center bg-white dark:bg-slate-800 p-4 rounded-3xl border shadow-sm">
            <button onClick={onBack} className="flex items-center gap-1 text-xs font-semibold text-slate-500"><IconArrowLeft /> ออก</button>
            <div className="text-xs font-bold text-slate-500">ข้อที่ {currentIndex + 1} / {session.words.length}</div>
            {settings.livesEnabled && (
              <div className="flex items-center gap-1">
                {[1, 2, 3].map(i => <IconHeart key={i} className={`w-4 h-4 ${i <= lives ? 'text-rose-500' : 'text-slate-300'}`} />)}
              </div>
            )}
            <div className="text-xs font-extrabold text-indigo-600 dark:text-indigo-400">คะแนน: {score}</div>
          </div>

          <div className="space-y-1">
            <div className="w-full h-2.5 rounded-full bg-slate-200 dark:bg-slate-800 overflow-hidden">
              <div className="h-full bg-amber-500 transition-all duration-100" style={{ width: `${timerPct}%` }} />
            </div>
          </div>

          <div className={`rounded-3xl p-8 border text-center space-y-4 ${settings.darkMode ? 'bg-slate-800 border-slate-700' : 'bg-white border-slate-200'}`}>
            <h2 className="text-3xl sm:text-5xl font-black text-indigo-600 dark:text-indigo-400">{currentWord.word}</h2>
            {currentWord.pronunciation && <p className="text-xs font-mono text-slate-400">[{currentWord.pronunciation}]</p>}
          </div>

          <div className="grid grid-cols-1 sm:grid-cols-2 gap-3">
            {options.map((opt, idx) => {
              let btnStyle = settings.darkMode ? 'bg-slate-800 border-slate-700 text-white' : 'bg-white border-slate-200 text-slate-800';
              if (isAnswered) {
                if (opt === currentWord.meaning) btnStyle = 'bg-emerald-500 text-white border-emerald-500';
                else if (opt === selectedOption) btnStyle = 'bg-rose-500 text-white border-rose-500 animate-shake';
                else btnStyle = 'opacity-40 bg-slate-100 dark:bg-slate-900 border-transparent';
              }

              return (
                <button key={idx} onClick={() => handleSelectOption(opt)} disabled={isAnswered} className={`p-4 rounded-2xl border text-sm sm:text-base font-bold transition-all text-left flex justify-between items-center ${btnStyle}`}>
                  <span>{opt}</span>
                  {isAnswered && opt === currentWord.meaning && <IconCheckCircle className="text-white" />}
                </button>
              );
            })}
          </div>
        </div>
      );
    }

    function ResultsView({ session, onPlayAgain, onPracticeMistakes, onHome, onViewStats, settings }) {
      const [showMistakes, setShowMistakes] = useState(false);
      const totalQuestions = session.correctCount + session.wrongCount;
      const accuracy = totalQuestions > 0 ? Math.round((session.correctCount / totalQuestions) * 100) : 100;

      return (
        <div className="max-w-xl mx-auto space-y-6 text-center animate-pop">
          <div className={`rounded-3xl p-8 border shadow-2xl ${settings.darkMode ? 'bg-slate-800 border-slate-700' : 'bg-white border-slate-200'}`}>
            <div className="w-16 h-16 rounded-full bg-amber-400 text-white mx-auto flex items-center justify-center text-3xl mb-3 shadow-lg">🏆</div>
            <h1 className="text-3xl font-black">{accuracy >= 80 ? '🎉 ยอดเยี่ยมมาก!' : '💪 ทำได้ดี พยายามต่อไป!'}</h1>
            <p className="text-xs text-slate-400 mt-1">สรุปผลการเล่นชุด "{session.setName}"</p>

            <div className="grid grid-cols-2 sm:grid-cols-4 gap-3 mt-6 pt-6 border-t border-slate-100 dark:border-slate-700">
              <div className="bg-slate-50 dark:bg-slate-900 p-3 rounded-2xl"><span className="text-xs text-slate-400 block">คะแนน</span><span className="text-xl font-black text-indigo-600">{session.score}</span></div>
              <div className="bg-slate-50 dark:bg-slate-900 p-3 rounded-2xl"><span className="text-xs text-slate-400 block">ความแม่นยำ</span><span className="text-xl font-black text-emerald-500">{accuracy}%</span></div>
              <div className="bg-slate-50 dark:bg-slate-900 p-3 rounded-2xl"><span className="text-xs text-slate-400 block">ตอบถูก</span><span className="text-xl font-black text-emerald-600">✓ {session.correctCount}</span></div>
              <div className="bg-slate-50 dark:bg-slate-900 p-3 rounded-2xl"><span className="text-xs text-slate-400 block">ตอบผิด</span><span className="text-xl font-black text-rose-500">✗ {session.wrongCount}</span></div>
            </div>
          </div>

          <div className="space-y-3">
            {session.missedWords.length > 0 && (
              <div className="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <button onClick={() => setShowMistakes(!showMistakes)} className="py-3 rounded-2xl border border-rose-200 bg-rose-50 dark:bg-rose-950/40 text-rose-600 font-semibold text-xs flex items-center justify-center gap-2">
                  <IconAlertTriangle /> ดูคำศัพท์ที่ตอบผิด ({session.missedWords.length})
                </button>
                <button onClick={onPracticeMistakes} className="py-3 rounded-2xl bg-rose-600 hover:bg-rose-700 text-white font-semibold text-xs shadow-lg shadow-rose-500/30 flex items-center justify-center gap-2">
                  <IconRefreshCw /> ฝึกเฉพาะคำที่ผิดเท่านั้น
                </button>
              </div>
            )}

            {showMistakes && session.missedWords.length > 0 && (
              <div className="p-4 rounded-3xl border bg-rose-50/50 dark:bg-rose-950/20 text-left space-y-2">
                <h4 className="font-bold text-sm text-rose-600">ทบทวนคำศัพท์ที่ตอบผิด:</h4>
                <div className="space-y-2 max-h-60 overflow-y-auto">
                  {session.missedWords.map(w => (
                    <div key={w.id} className="p-3 bg-white dark:bg-slate-800 rounded-2xl border text-xs flex justify-between items-center">
                      <div>
                        <span className="font-bold text-indigo-600 dark:text-indigo-400">{w.word}</span> = {w.meaning}
                      </div>
                      <button onClick={() => speakText(w.word)} className="text-slate-400 hover:text-indigo-600"><IconVolume /></button>
                    </div>
                  ))}
                </div>
              </div>
            )}

            <div className="grid grid-cols-2 gap-3">
              <button onClick={onPlayAgain} className="py-3 rounded-2xl bg-indigo-600 hover:bg-indigo-700 text-white font-semibold text-sm shadow-lg shadow-indigo-500/30">เล่นอีกครั้ง</button>
              <button onClick={onHome} className="py-3 rounded-2xl border font-semibold text-sm hover:bg-slate-100 dark:hover:bg-slate-800">กลับหน้าหลัก</button>
            </div>
          </div>
        </div>
      );
    }

    function StatsDashboardView({ userStats, sets, settings }) {
      const allWords = useMemo(() => sets.flatMap(s => s.words || []), [sets]);
      const masteryBreakdown = useMemo(() => {
        let learned = 0, reviewing = 0, needsWork = 0;
        allWords.forEach(word => {
          const stat = userStats.wordMastery[word.id];
          if (!stat) needsWork++;
          else if (stat.correctCount >= 3 && stat.correctCount > stat.wrongCount) learned++;
          else if (stat.correctCount > 0) reviewing++;
          else needsWork++;
        });
        return { learned, reviewing, needsWork };
      }, [allWords, userStats.wordMastery]);

      return (
        <div className="space-y-8 animate-pop">
          <h1 className="text-2xl sm:text-3xl font-extrabold">สถิติการเรียนรู้ของคุณ (Statistics)</h1>

          <div className="grid grid-cols-2 md:grid-cols-4 gap-4">
            <div className={`p-5 rounded-3xl border ${settings.darkMode ? 'bg-slate-800 border-slate-700' : 'bg-white border-slate-200'}`}>
              <span className="text-xs text-slate-400 block font-semibold">จำนวนเกมที่เล่น</span>
              <span className="text-3xl font-black">{userStats.totalGames} ครั้ง</span>
            </div>
            <div className={`p-5 rounded-3xl border ${settings.darkMode ? 'bg-slate-800 border-slate-700' : 'bg-white border-slate-200'}`}>
              <span className="text-xs text-slate-400 block font-semibold">คำถามที่ตอบแล้ว</span>
              <span className="text-3xl font-black">{userStats.totalQuestions} ข้อ</span>
            </div>
            <div className={`p-5 rounded-3xl border ${settings.darkMode ? 'bg-slate-800 border-slate-700' : 'bg-white border-slate-200'}`}>
              <span className="text-xs text-slate-400 block font-semibold">Streak สูงสุด</span>
              <span className="text-3xl font-black text-amber-500">🔥 {userStats.bestStreak}</span>
            </div>
            <div className={`p-5 rounded-3xl border ${settings.darkMode ? 'bg-slate-800 border-slate-700' : 'bg-white border-slate-200'}`}>
              <span className="text-xs text-slate-400 block font-semibold">ความแม่นยำรวม</span>
              <span className="text-3xl font-black text-indigo-600 dark:text-indigo-400">{userStats.totalQuestions > 0 ? Math.round((userStats.totalCorrect / userStats.totalQuestions) * 100) : 0}%</span>
            </div>
          </div>

          <div className={`p-6 rounded-3xl border ${settings.darkMode ? 'bg-slate-800 border-slate-700' : 'bg-white border-slate-200'}`}>
            <h3 className="font-bold text-lg mb-4">ระดับการจดจำคำศัพท์ (Word Mastery Tiers)</h3>
            <div className="grid grid-cols-1 sm:grid-cols-3 gap-4">
              <div className="p-4 rounded-2xl bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-300 dark:border-emerald-800">
                <span className="text-xs font-bold text-emerald-700 dark:text-emerald-400 uppercase">🟢 จำได้ดีเยี่ยม</span>
                <span className="text-2xl font-black text-emerald-600 block">{masteryBreakdown.learned} คำ</span>
              </div>
              <div className="p-4 rounded-2xl bg-amber-50 dark:bg-amber-950/40 border border-amber-300 dark:border-amber-800">
                <span className="text-xs font-bold text-amber-700 dark:text-amber-400 uppercase">🟡 อยู่ระหว่างทบทวน</span>
                <span className="text-2xl font-black text-amber-600 block">{masteryBreakdown.reviewing} คำ</span>
              </div>
              <div className="p-4 rounded-2xl bg-rose-50 dark:bg-rose-950/40 border border-rose-300 dark:border-rose-800">
                <span className="text-xs font-bold text-rose-700 dark:text-rose-400 uppercase">🔴 ต้องฝึกเพิ่มเติม</span>
                <span className="text-2xl font-black text-rose-600 block">{masteryBreakdown.needsWork} คำ</span>
              </div>
            </div>
          </div>
        </div>
      );
    }

    function AchievementsView({ achievements, settings }) {
      return (
        <div className="space-y-6 animate-pop">
          <h1 className="text-2xl sm:text-3xl font-extrabold">ความสำเร็จและเหรียญรางวัล (Badges)</h1>
          <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
            {achievements.map(ach => (
              <div key={ach.id} className={`p-5 rounded-3xl border flex items-start gap-4 ${ach.unlocked ? settings.darkMode ? 'bg-slate-800 border-amber-500/50' : 'bg-white border-amber-300 shadow-sm' : 'opacity-60 bg-slate-100 dark:bg-slate-900'}`}>
                <div className="w-12 h-12 rounded-2xl bg-amber-400 text-white flex items-center justify-center text-xl flex-shrink-0 shadow-md">{ach.icon}</div>
                <div className="space-y-1 flex-1">
                  <div className="flex justify-between items-center">
                    <h4 className="font-bold text-base">{ach.title}</h4>
                    {ach.unlocked && <span className="text-[10px] font-bold px-2 py-0.5 rounded-full bg-amber-100 text-amber-800">ปลดล็อกแล้ว</span>}
                  </div>
                  <p className="text-xs text-slate-500">{ach.desc}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      );
    }

    const root = ReactDOM.createRoot(document.getElementById('root'));
    root.render(<App />);
  </script>
</body>
</html>
