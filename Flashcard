    function FlashcardMode({ session, onFinish, onBack, settings }) {
      const [currentIndex, setCurrentIndex] = useState(0);
      const [isFlipped, setIsFlipped] = useState(false);
      const currentWord = session.words[currentIndex] || session.words[0];

      useEffect(() => { setIsFlipped(false); }, [currentIndex]);

      useEffect(() => {
        const handleKeyDown = (e) => {
          if (e.code === 'Space') {
            e.preventDefault();
            setIsFlipped(p => !p);
            playAudioFX('flip', settings.soundEnabled);
          } else if (e.code === 'ArrowRight') handleNext();
          else if (e.code === 'ArrowLeft') handlePrev();
          else if (e.code === 'KeyS' && currentWord) speakText(currentWord.word);
        };
        window.addEventListener('keydown', handleKeyDown);
        return () => window.removeEventListener('keydown', handleKeyDown);
      }, [currentIndex, currentWord]);

      const handleNext = () => {
        playAudioFX('click', settings.soundEnabled);
        if (currentIndex < session.words.length - 1) setCurrentIndex(prev => prev + 1);
        else onFinish({ ...session, correctCount: session.words.length, wrongCount: 0, score: session.words.length * 10 });
      };

      const handlePrev = () => {
        playAudioFX('click', settings.soundEnabled);
        if (currentIndex > 0) setCurrentIndex(prev => prev - 1);
      };

      if (!currentWord) return null;

      return (
        <div className="max-w-2xl mx-auto space-y-6 animate-pop">
          <div className="flex justify-between items-center">
            <button onClick={onBack} className="flex items-center gap-1.5 text-sm font-semibold text-slate-500 hover:text-indigo-600"><IconArrowLeft /> ออก</button>
            <div className="text-xs font-bold text-slate-500">การ์ดที่ {currentIndex + 1} / {session.words.length}</div>
          </div>

          <div 
            className="perspective-1000 w-full h-80 sm:h-96 cursor-pointer select-none"
            onClick={() => { setIsFlipped(!isFlipped); playAudioFX('flip', settings.soundEnabled); }}
          >
            <div className={`relative w-full h-full duration-500 transform-style-3d transition-transform ${isFlipped ? 'rotate-y-180' : ''}`}>
              
              <div className={`absolute inset-0 backface-hidden rounded-3xl p-8 flex flex-col justify-between shadow-xl border-2 ${settings.darkMode ? 'bg-slate-800 border-slate-700 text-white' : 'bg-white border-indigo-100 text-slate-800'}`}>
                <div className="flex justify-between text-xs text-slate-400 uppercase font-semibold">
                  <span>English Word</span>
                  <span className="text-indigo-500">แตะเพื่อพลิกดูคำแปล</span>
                </div>
                <div className="text-center my-auto space-y-4">
                  <h2 className="text-3xl sm:text-5xl font-black text-indigo-600 dark:text-indigo-400">{currentWord.word}</h2>
                  <button onClick={(e) => { e.stopPropagation(); speakText(currentWord.word); }} className="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-indigo-50 text-indigo-600 dark:bg-indigo-950 dark:text-indigo-300 text-xs font-bold hover:scale-105 transition-transform">
                    <IconVolume /> ฟังเสียงอ่าน
                  </button>
                </div>
                <div className="text-center text-xs text-slate-400">กดปุ่ม <kbd className="px-1.5 py-0.5 border rounded">Spacebar</kbd> เพื่อพลิกการ์ด</div>
              </div>

              <div className="absolute inset-0 backface-hidden rotate-y-180 rounded-3xl p-8 flex flex-col justify-between shadow-xl bg-gradient-to-br from-indigo-600 via-violet-600 to-purple-700 text-white">
                <div className="flex justify-between text-xs text-indigo-200 uppercase font-semibold">
                  <span>คำแปลภาษาไทย</span>
                  {currentWord.pronunciation && <span className="font-mono text-amber-300">[{currentWord.pronunciation}]</span>}
                </div>
                <div className="text-center my-auto space-y-3">
                  <h2 className="text-2xl sm:text-4xl font-extrabold">{currentWord.meaning}</h2>
                  {currentWord.example && <p className="bg-white/10 p-3 rounded-2xl text-xs sm:text-sm italic">"{currentWord.example}"</p>}
                </div>
                <div className="text-center text-xs text-indigo-200">แตะอีกครั้งเพื่อกลับด้านหน้า</div>
              </div>

            </div>
          </div>

          <div className="flex items-center justify-between gap-4">
            <button onClick={handlePrev} disabled={currentIndex === 0} className="flex-1 py-3 rounded-2xl border font-semibold text-sm disabled:opacity-40 flex items-center justify-center gap-2">
              <IconArrowLeft /> ย้อนกลับ
            </button>
            <button onClick={() => { setIsFlipped(!isFlipped); playAudioFX('flip', settings.soundEnabled); }} className="p-3 rounded-2xl bg-indigo-50 text-indigo-600"><IconRotateCw /></button>
            <button onClick={handleNext} className="flex-1 py-3 rounded-2xl bg-indigo-600 text-white font-semibold text-sm shadow-lg flex items-center justify-center gap-2">
              <span>{currentIndex === session.words.length - 1 ? 'เสร็จสิ้น' : 'ถัดไป'}</span> <IconArrowRight />
            </button>
          </div>
        </div>
      );
